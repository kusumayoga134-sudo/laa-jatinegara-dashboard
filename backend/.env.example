# Database PostgreSQL Neon (https://neon.tech - Free, No Credit Card Required)
# Format dari Neon Dashboard: postgresql://username:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"

# Port Server (diabaikan saat berjalan di Vercel Serverless, digunakan untuk npm start lokal)
PORT=5000

# URL Frontend Vercel (pisahkan dengan koma jika lebih dari satu)
FRONTEND_URL="https://laa-jatinegara-dashboard.vercel.app,http://localhost:3000,http://localhost:5173"
